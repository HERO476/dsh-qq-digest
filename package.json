{
  "name": "dsh-qq-digest",
  "version": "0.2.2",
  "description": "只读的 DSH QQ 摘要插件：群聊默认全开、私聊默认全关且只能逐条打开；MCP 四个只读工具 + 设置页（选群/起名/定时/立即总结），零发送能力",
  "type": "module",
  "license": "MIT",
  "author": "huangpeiyan",
  "homepage": "https://github.com/HERO476/dsh-qq-digest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HERO476/dsh-qq-digest.git"
  },
  "bugs": {
    "url": "https://github.com/HERO476/dsh-qq-digest/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "digest",
    "summary",
    "群聊",
    "摘要",
    "cordis",
    "mcp"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "install",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-core-purity.mjs",
    "verify": "node scripts/check-core-purity.mjs && node --test",
    "smoke": "node scripts/smoke.mjs",
    "check:all": "node scripts/check-all.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
